# ── Runtime Mode ──────────────────────────────────────
# "local" = Ollama on your machine (default, zero cost)
# "cloud" = Groq / Gemini free APIs (auto-fallback when Ollama isn't running)
MODEL_MODE=local

# ── Ollama (Local) ───────────────────────────────────
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b

# ── Cloud Fallbacks ──────────────────────────────────
GROQ_API_KEY=
GEMINI_API_KEY=

# ── Sarvam AI (Voice Layer) ──────────────────────────
SARVAM_API_KEY=

# ── Server ───────────────────────────────────────────
SERVER_PORT=8000
CLIENT_URL=http://localhost:3000
